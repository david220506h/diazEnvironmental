---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Page Not Found | Diaz Environmental LLC"
  description="Page not found. Return to Diaz Environmental LLC home page."
>
  <main style="text-align:center; padding: 8rem 2rem; font-family:'Poppins',sans-serif;">
    <h1 style="font-size:5rem; font-weight:800; color:#154a2a; margin-bottom:0.5rem;">404</h1>
    <h2 style="font-size:1.8rem; color:#333; margin-bottom:1rem;">Page not found</h2>
    <p style="color:#666; margin-bottom:2rem;">The page you are looking for doesn't exist or has been moved.</p>
    <a href="/" style="display:inline-block; background:#154a2a; color:white; padding:12px 28px; border-radius:8px; text-decoration:none; font-weight:600;">
      Go Home
    </a>
  </main>
</Layout>