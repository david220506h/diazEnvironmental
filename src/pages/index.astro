---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Nabvar/nabvar.jsx";
import Hero from "../components/hero/Hero.jsx";
import Services from "../components/Services/Services.jsx";
import AboutUs from "../components/aboutUs/aboutUs";
import Projects from "../components/Proyects/proyects";
import Contact from "../components/Contact/contact";
import Footer from "../components/Footer/Footer.jsx";
import FloatingContact from "../components/FloatingContact/floatingContact";
import LanguageModal from "../components/lenguajeModal/lenguageModal";
import SmoothScroll from "../components/SmoothScroll/SmoothScroll.jsx";
import CustomCursor from "../components/CustomCursor/CustomCursor.jsx";
---

<Layout>
  <!-- Oculta el contenido del Hero hasta que GSAP lo anime (evita el parpadeo al hidratar).
       Si el JS falla, se vuelve visible solo a los 4 s. -->
  <script is:inline>
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("hero-anim");
      setTimeout(function () { document.documentElement.classList.remove("hero-anim"); }, 4000);
    }
  </script>
  <SmoothScroll client:load />
  <CustomCursor client:load />
  <LanguageModal client:load />
  <Navbar client:load />
  <Hero client:load />
  <!-- client:load (no :visible): así el reveal prepara las tarjetas antes de que entren en pantalla, sin parpadeo -->
  <Services client:load />
  <section id="about">
    <AboutUs client:visible />
  </section>
  <Projects client:visible />
  <Contact client:visible />
  <Footer client:visible />
  <FloatingContact client:load />
</Layout>