---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = "Diaz Environmental LLC | Septic System Design & Testing Arizona",
  description = "ADEQ-certified septic system design, soil evaluation & percolation testing in Maricopa County, AZ. Fast 3-5 day turnaround. Hablamos español. Call (602) 812-8609.",
  canonical = "https://diazenviroaz.com",
  noindex = false,
} = Astro.props;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Diaz Environmental LLC",
  "description": "ADEQ-certified septic system design, soil evaluation, percolation testing and environmental services in Maricopa County and surrounding areas of Arizona.",
  "telephone": "+16028128609",
  "email": "septic@diazenviroaz.com",
  "url": "https://diazenviroaz.com",
  "logo": "https://diazenviroaz.com/logo.png",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Phoenix",
    "addressRegion": "AZ",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 33.4484,
    "longitude": -112.0740
  },
  "areaServed": [
    "Maricopa County", "Pinal County", "Yavapai County", "La Paz County",
    "Phoenix", "Scottsdale", "Mesa", "Chandler", "Gilbert",
    "Queen Creek", "San Tan Valley", "Maricopa City",
    "Cave Creek", "Carefree", "Anthem", "New River", "Tonopah", "Laveen",
    "Wickenburg", "Buckeye", "Goodyear", "Avondale",
    "Rio Verde", "Fountain Hills", "Paradise Valley",
    "Parker", "Quartzsite", "Prescott", "Prescott Valley",
    "All Native Nations", "Arizona"
  ],
  "openingHours": ["Mo-Fr 08:00-18:00", "Sa 09:00-14:00"],
  "priceRange": "$$",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Septic & Environmental Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Septic System Design Arizona" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Percolation Testing Arizona" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Soil Evaluation Arizona" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Seepage Pit Testing Arizona" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Septic System Inspection Arizona" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ADEQ Septic Permits Arizona" } }
    ]
  },
  "sameAs": [
    "https://www.instagram.com/diazenviroaz",
    "https://www.facebook.com/diazenviroaz"
  ]
});
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        try {
          var lang = localStorage.getItem("language");
          if (lang === "es" || lang === "en") {
            document.documentElement.lang = lang;
          }
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://diazenviroaz.com/og-image.png" />
    <meta property="og:image:width" content="1250" />
    <meta property="og:image:height" content="625" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://diazenviroaz.com/og-image.png" />
    <meta name="geo.region" content="US-AZ" />
    <meta name="geo.placename" content="Phoenix, Arizona" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon.ico" />

    <script type="application/ld+json" set:html={schema} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Paleta de marca. Valores exactos ya usados en la página principal */
  :root {
    --color-green-950: #0b2e1a;
    --color-green-900: #0f3d24;
    --color-green-800: #154a2a;
    --color-green-700: #1a5f36; /* verde principal */
    --color-green-600: #2d7a4f;
    --color-green-50: #f0f8f1;
    --color-brand-vivid: #006414; /* verde más saturado, uso intencional en logo y link activo del navbar */
    --color-mint: #9fd3ae;      /* acento sobre fondos verdes oscuros */
    --color-cream: #f4f1e6;     /* CTAs principales */
    --color-gold: #f5c451;      /* estrellas */
    --color-text: #333;
    --color-text-muted: #666;
    --color-surface: #f8f9fa;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
  }

  html, body {
    overflow-x: hidden;
  }

  /* Scroll suave nativo solo donde Lenis no está activo (landings SEO) */
  html:not(.lenis) {
    scroll-behavior: smooth;
  }

  body {
    margin-top: 80px;
  }

  section {
    min-height: 100vh;
    padding: 100px 0;
  }

  section#about {
    min-height: 20vh;
    padding: 10px 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* Única definición de .container (antes duplicada en Project.css, que era la que ganaba con 2rem) */
  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-title {
    text-align: center;
    margin-bottom: 60px;
    font-size: 2.5rem;
    font-weight: 700;
    position: relative;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 4px;
    background-color: var(--color-green-700);
  }

  .btn {
    display: inline-block;
    padding: 12px 28px;
    background-color: var(--color-green-800);
    color: white;
    border-radius: 5px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .btn:hover {
    background-color: #0d3019;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }
</style>